{
  "name": "dsh-grok-provider",
  "version": "0.1.2-rc.1",
  "description": "Clean-room Grok Build provider for DeepSeek Harness with official CLI browser authentication",
  "type": "module",
  "license": "MIT",
  "author": "YukiRyou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshino-xiao7/dsh-grok-provider.git"
  },
  "homepage": "https://github.com/yoshino-xiao7/dsh-grok-provider#readme",
  "bugs": {
    "url": "https://github.com/yoshino-xiao7/dsh-grok-provider/issues"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/host/index.mjs"
    },
    "./client": {
      "default": "./dist/client/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "grok-provider.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "docs",
    "types",
    "grok-provider.patch.yml",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test spikes/protocol/test/*.test.mjs test/*.test.mjs",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run --json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-subprocess": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
